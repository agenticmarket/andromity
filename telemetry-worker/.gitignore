# ── Secrets & local config ────────────────────────────────────────────────────
.env
.dev.vars

# ── Wrangler ──────────────────────────────────────────────────────────────────
# Local build cache, miniflare state, and tmp files — never commit these
.wrangler/

# Generated by deploy.js at deploy time; contains the real KV namespace ID.
# Deleted automatically after deploy, but gitignored as a safety net.
wrangler.deploy.toml

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json

# ── Local test scripts ────────────────────────────────────────────────────────
# These contain hardcoded internal URLs and are only useful locally
test_ping.py

# ── OS / Editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
