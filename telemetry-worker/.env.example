# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit the real .env file.

# Your Cloudflare D1 Database ID for telemetry storage.
# Create one with: npx wrangler d1 create andromity-telemetry
# Apply schema:    npx wrangler d1 execute andromity-telemetry --file=schema.sql
TELEMETRY_D1_ID=your_d1_database_id_here

# Secret key required to access GET /api/stats (internal dashboard access)
STATS_SECRET=your_secret_admin_token_here
