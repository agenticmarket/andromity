# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit the real .env file.

# Your Cloudflare KV Namespace ID for telemetry storage.
# Create one with: npx wrangler kv namespace create TELEMETRY_KV
TELEMETRY_KV_ID=your_kv_namespace_id_here

# Secret key required to access GET /api/stats (internal dashboard access)
STATS_SECRET=your_secret_admin_token_here
