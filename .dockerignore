# Allowlist: the image is built only from the files the Dockerfile copies.
*
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!src/
!docker-entrypoint.sh

# Never include local state, caches or secrets from inside src/.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.andromity/
**/.env*
**/.dev.vars
**/*.pem
**/*.key
**/*.log
src/test.txt
