{
  "name": "andromity-agent",
  "displayName": "Andromity: Free AI Coding Agent for VS Code",
  "description": "Free, open-source AI coding agent and an alternative to Cline, Kilo Code, Claude Code and Cursor that shows exactly what it did: live Waterfall, Fingerprint and Blast radius of every model call, file and command. Use DeepSeek V4, GLM 5.3, Kimi K3, Qwen, Claude Opus 5.5, GPT-6, Gemini 4 or Grok with your own keys, OpenRouter or free local Ollama. MCP, subagents, diffs and undo.",
  "version": "0.2.21",
  "publisher": "agenticmarket",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://andromity.agenticmarket.dev",
  "bugs": {
    "url": "https://github.com/agenticmarket/andromity/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agenticmarket/andromity"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Andromity requires workspace trust to edit files and execute terminal commands.",
      "restrictedConfigurations": [
        "andromity.pythonPath",
        "andromity.serverPort",
        "andromity.ollamaHost",
        "andromity.permissionMode",
        "andromity.includeCoAuthor",
        "andromity.includeAssistedBy",
        "andromity.wallpaper.rippleIntensity"
      ]
    }
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning",
    "Testing",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "ai coding agent",
    "free ai coding agent",
    "free coding agent",
    "free ai agent",
    "coding agent",
    "ai agent",
    "autonomous coding agent",
    "open source",
    "cline alternative",
    "kilo code alternative",
    "claude code alternative",
    "cursor alternative",
    "roo code alternative",
    "codex alternative",
    "byok",
    "ollama",
    "ollama coding agent",
    "local ai agent",
    "mcp",
    "openrouter",
    "deepseek",
    "gemini",
    "claude",
    "glm 5.3",
    "kimi k3",
    "claude opus 5.5",
    "gpt-6",
    "gemini 4",
    "grok 4.7"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "andromity-logo": {
        "description": "Andromity Logo",
        "default": {
          "fontPath": "media/andromity-font.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "andromity-sidebar",
          "title": "Andromity",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "andromity-sidebar": [
        {
          "type": "webview",
          "id": "andromity.chatView",
          "name": "Andromity",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "andromity.openChat",
        "title": "Open Chat",
        "category": "Andromity",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "andromity.newSession",
        "title": "New Session",
        "category": "Andromity",
        "icon": "$(add)"
      },
      {
        "command": "andromity.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Andromity",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "andromity.explainCode",
        "title": "Explain Code",
        "category": "Andromity",
        "icon": "$(info)"
      },
      {
        "command": "andromity.fixErrors",
        "title": "Fix Diagnostics & Errors",
        "category": "Andromity",
        "icon": "$(tools)"
      },
      {
        "command": "andromity.generateTests",
        "title": "Generate Unit Tests",
        "category": "Andromity",
        "icon": "$(beaker)"
      },
      {
        "command": "andromity.undoTurn",
        "title": "Undo Last Turn & Rollback Diff",
        "category": "Andromity",
        "icon": "$(discard)"
      },
      {
        "command": "andromity.viewGitDiff",
        "title": "View File Diffs (Changed Files)",
        "category": "Andromity",
        "icon": "$(diff)"
      },
      {
        "command": "andromity.showSessions",
        "title": "Show Sessions History",
        "category": "Andromity",
        "icon": "$(history)"
      },
      {
        "command": "andromity.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Andromity",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "andromity.openSettings",
        "title": "Settings & API Keys",
        "category": "Andromity",
        "icon": "$(gear)"
      },
      {
        "command": "andromity.switchModel",
        "title": "Switch Model…",
        "category": "Andromity",
        "icon": "$(sparkle)"
      },
      {
        "command": "andromity.switchMode",
        "title": "Switch Permission Mode…",
        "category": "Andromity",
        "icon": "$(shield)"
      },
      {
        "command": "andromity.switchProfile",
        "title": "Switch Agent Profile…",
        "category": "Andromity",
        "icon": "$(person)"
      },
      {
        "command": "andromity.openModelHub",
        "title": "Open Model Hub",
        "category": "Andromity",
        "icon": "$(library)"
      },
      {
        "command": "andromity.openCrons",
        "title": "Open Cron Jobs",
        "category": "Andromity",
        "icon": "$(clock)"
      },
      {
        "command": "andromity.login",
        "title": "Sign In",
        "category": "Andromity",
        "icon": "$(sign-in)"
      },
      {
        "command": "andromity.logout",
        "title": "Sign Out",
        "category": "Andromity",
        "icon": "$(sign-out)"
      },
      {
        "command": "andromity.openAbout",
        "title": "About & System Diagnostics",
        "category": "Andromity",
        "icon": "$(info)"
      },
      {
        "command": "andromity.rateExtension",
        "title": "Rate & Review Andromity",
        "category": "Andromity",
        "icon": "$(star-empty)"
      },
      {
        "command": "andromity.shareExtension",
        "title": "Share Andromity with Developers",
        "category": "Andromity",
        "icon": "$(link-external)"
      },
      {
        "command": "andromity.openPersonalisation",
        "title": "Personalisation & Atmosphere",
        "category": "Andromity",
        "icon": "$(paintcan)"
      },
      {
        "command": "andromity.checkSetup",
        "title": "System Setup Check",
        "category": "Andromity",
        "icon": "$(check)"
      },
      {
        "command": "andromity.restartServer",
        "title": "Restart Engine / Server",
        "category": "Andromity",
        "icon": "$(refresh)"
      },
      {
        "command": "andromity.compactSession",
        "title": "Compact Session Context",
        "category": "Andromity",
        "icon": "$(fold-up)"
      },
      {
        "command": "andromity.attachFileToContext",
        "title": "Attach to Andromity Context",
        "category": "Andromity",
        "icon": "$(file-add)"
      },
      {
        "command": "andromity.openFileDiff",
        "title": "Open File Diff",
        "category": "Andromity"
      },
      {
        "command": "andromity.openReview",
        "title": "Changes Review",
        "category": "Andromity",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "andromity.openSessionInTab",
        "title": "Open Session in Editor Tab (Pop Out)",
        "category": "Andromity",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "andromity.openWaterfall",
        "title": "Waterfall Trace",
        "category": "Andromity",
        "icon": {
          "light": "media/waterfall.svg",
          "dark": "media/waterfall.svg"
        }
      },
      {
        "command": "andromity.openFingerprint",
        "title": "Fingerprint Trace & Blast Radius",
        "category": "Andromity",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "andromity.deleteSession",
        "title": "Delete Session",
        "category": "Andromity",
        "icon": "$(trash)"
      },
      {
        "command": "andromity.welcome",
        "title": "Welcome / Getting Started",
        "category": "Andromity",
        "icon": "$(rocket)"
      },
      {
        "command": "andromity.fixNotebookCell",
        "title": "Fix Cell Error with Andromity",
        "category": "Andromity",
        "icon": "$(tools)"
      },
      {
        "command": "andromity.explainNotebookCell",
        "title": "Explain Notebook Cell",
        "category": "Andromity",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "andromity.fixTerminalError",
        "title": "Fix Terminal Error with Andromity",
        "category": "Andromity",
        "icon": "$(tools)"
      },
      {
        "command": "andromity.inlineEdit",
        "title": "Edit with Andromity",
        "category": "Andromity",
        "icon": "$(sparkle)"
      },
      {
        "command": "andromity.inlineEdit.accept",
        "title": "Accept Inline Edit",
        "category": "Andromity"
      },
      {
        "command": "andromity.inlineEdit.reject",
        "title": "Reject Inline Edit",
        "category": "Andromity"
      },
      {
        "command": "andromity.inlineEdit.compare",
        "title": "Compare Inline Edit",
        "category": "Andromity"
      },
      {
        "command": "andromity.chat.resolveApproval",
        "title": "Respond to Tool Approval",
        "category": "Andromity"
      },
      {
        "command": "andromity.chat.answerQuestions",
        "title": "Answer Agent Questions",
        "category": "Andromity"
      },
      {
        "command": "andromity.addToChat",
        "title": "Add to Andromity",
        "category": "Andromity",
        "icon": "$(add)"
      },
      {
        "command": "andromity.toggleAirGap",
        "title": "Air-gap Mode: Turn On or Off",
        "category": "Andromity",
        "icon": "$(shield)"
      },
      {
        "command": "andromity.airGapSelfTest",
        "title": "Air-gap Mode: Run Self-test",
        "category": "Andromity",
        "icon": "$(beaker)"
      },
      {
        "command": "andromity.copyChatMarkdown",
        "title": "Copy Chat as Markdown",
        "category": "Andromity",
        "icon": "$(markdown)"
      }
    ],
    "keybindings": [
      {
        "command": "andromity.openChat",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "andromity.askAboutSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      },
      {
        "command": "andromity.explainCode",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "andromity.generateTests",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorHasSelection"
      },
      {
        "command": "andromity.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && !inlineChatHasProvider && !andromity.inlineEditPending"
      },
      {
        "command": "andromity.inlineEdit.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && andromity.inlineEditPending"
      },
      {
        "command": "andromity.inlineEdit.reject",
        "key": "escape",
        "when": "editorTextFocus && andromity.inlineEditPending && !suggestWidgetVisible && !inlineSuggestionVisible"
      }
    ],
    "submenus": [
      {
        "id": "andromity.editorMenu",
        "label": "Andromity"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "andromity.openFileDiff",
          "when": "false"
        },
        {
          "command": "andromity.deleteSession",
          "when": "false"
        },
        {
          "command": "andromity.openSessionInTab",
          "when": "false"
        },
        {
          "command": "andromity.welcome",
          "when": "false"
        },
        {
          "command": "andromity.inlineEdit.accept",
          "when": "andromity.inlineEditPending"
        },
        {
          "command": "andromity.inlineEdit.reject",
          "when": "andromity.inlineEditPending"
        },
        {
          "command": "andromity.inlineEdit.compare",
          "when": "andromity.inlineEditPending"
        },
        {
          "command": "andromity.chat.resolveApproval",
          "when": "false"
        },
        {
          "command": "andromity.chat.answerQuestions",
          "when": "false"
        },
        {
          "command": "andromity.inlineEdit",
          "when": "editorIsOpen && !editorReadonly"
        }
      ],
      "editor/context": [
        {
          "command": "andromity.addToChat",
          "group": "0_andromity@1"
        },
        {
          "command": "andromity.inlineEdit",
          "group": "0_andromity@2",
          "when": "!editorReadonly"
        },
        {
          "submenu": "andromity.editorMenu",
          "group": "andromity@1"
        }
      ],
      "andromity.editorMenu": [
        {
          "command": "andromity.inlineEdit",
          "group": "1_actions@0",
          "when": "!editorReadonly"
        },
        {
          "command": "andromity.askAboutSelection",
          "group": "1_actions@1",
          "when": "editorHasSelection"
        },
        {
          "command": "andromity.explainCode",
          "group": "1_actions@2",
          "when": "editorHasSelection"
        },
        {
          "command": "andromity.fixErrors",
          "group": "1_actions@3"
        },
        {
          "command": "andromity.generateTests",
          "group": "1_actions@4",
          "when": "editorHasSelection"
        }
      ],
      "scm/title": [
        {
          "command": "andromity.generateCommitMessage",
          "group": "navigation@1",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "andromity.openChat",
          "group": "navigation@1",
          "when": "!andromity.isAgentRunning && !editorReadonly"
        },
        {
          "command": "andromity.openWaterfall",
          "group": "navigation@1",
          "when": "andromity.isAgentRunning && !editorReadonly"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "andromity.fixNotebookCell",
          "group": "inline@1",
          "when": "notebookCellType == code"
        },
        {
          "command": "andromity.explainNotebookCell",
          "group": "inline@2",
          "when": "notebookCellType == code"
        }
      ],
      "terminal/context": [
        {
          "command": "andromity.fixTerminalError",
          "group": "navigation@1"
        }
      ],
      "terminal/title/context": [
        {
          "command": "andromity.fixTerminalError",
          "group": "1_actions"
        }
      ],
      "explorer/context": [
        {
          "command": "andromity.attachFileToContext",
          "group": "andromity@1"
        },
        {
          "command": "andromity.explainCode",
          "group": "andromity@2"
        },
        {
          "command": "andromity.generateTests",
          "group": "andromity@3"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "andromity.openFileDiff",
          "group": "andromity@1"
        }
      ],
      "view/title": [
        {
          "command": "andromity.fixTerminalError",
          "when": "view == terminal",
          "group": "navigation"
        },
        {
          "command": "andromity.newSession",
          "when": "view == andromity.chatView",
          "group": "navigation@1"
        },
        {
          "command": "andromity.openReview",
          "when": "view == andromity.chatView",
          "group": "navigation@2"
        },
        {
          "command": "andromity.viewGitDiff",
          "when": "view == andromity.chatView",
          "group": "navigation@3"
        },
        {
          "command": "andromity.showSessions",
          "when": "view == andromity.chatView",
          "group": "navigation@3"
        },
        {
          "command": "andromity.openSettings",
          "when": "view == andromity.chatView",
          "group": "navigation@4"
        },
        {
          "command": "andromity.checkSetup",
          "when": "view == andromity.chatView",
          "group": "1_more@1"
        },
        {
          "command": "andromity.restartServer",
          "when": "view == andromity.chatView",
          "group": "1_more@2"
        },
        {
          "command": "andromity.compactSession",
          "when": "view == andromity.chatView",
          "group": "1_more@3"
        },
        {
          "command": "andromity.undoTurn",
          "when": "view == andromity.chatView",
          "group": "1_more@4"
        },
        {
          "command": "andromity.welcome",
          "when": "view == andromity.chatView",
          "group": "1_more@5"
        }
      ],
      "view/item/context": [
        {
          "command": "andromity.deleteSession",
          "when": "view == andromity.sessionsView && viewItem == sessionItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Andromity",
      "properties": {
        "andromity.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python executable with Andromity installed (auto-detected if empty)."
        },
        "andromity.defaultProvider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "google",
            "groq",
            "openrouter",
            "ollama",
            "nvidia"
          ],
          "description": "Default AI provider.",
          "markdownDeprecationMessage": "Not used. Choose the provider and model in **Andromity Settings → Model Hub** or with `/model` in chat; the choice is saved in `config.toml`."
        },
        "andromity.defaultModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Default model ID.",
          "markdownDeprecationMessage": "Not used. Choose the provider and model in **Andromity Settings → Model Hub** or with `/model` in chat; the choice is saved in `config.toml`."
        },
        "andromity.startupSession": {
          "type": "string",
          "default": "fresh",
          "enum": [
            "last",
            "fresh"
          ],
          "enumDescriptions": [
            "Resume the session that was active when the panel/window was last closed.",
            "Always start a new empty session on load (previous sessions remain in history)."
          ],
          "description": "Which chat session to open when the Andromity panel loads (applies on window reload or panel reopen)."
        },
        "andromity.defaultProfile": {
          "type": "string",
          "default": "builder",
          "enum": [
            "builder",
            "coder",
            "reviewer",
            "planner"
          ],
          "description": "Default Agent Profile: Builder (plans & implements), Coder (direct act), Reviewer (audit), Planner (plans only).",
          "markdownDeprecationMessage": "Not used. Set the default profile in **Andromity Settings → Preferences → Agent Profile**; it is saved in `config.toml`."
        },
        "andromity.permissionMode": {
          "type": "string",
          "default": "safe",
          "enum": [
            "safe",
            "trust",
            "full",
            "yolo"
          ],
          "description": "Trust Permission Mode: SAFE (review all), TRUST (auto file/shell in trusted dirs), FULL (auto-run with logs), YOLO (silent autonomous).",
          "enumDescriptions": [
            "Asks before every file write and shell command.",
            "Auto-approves file edits inside the workspace and allowlisted shell commands. Asks before anything else.",
            "Auto-approves all actions and logs each one in the chat.",
            "Warning: edits files and runs shell commands without asking and without review prompts."
          ],
          "markdownDescription": "Default permission mode for new turns. **YOLO** runs shell commands and edits files without asking."
        },
        "andromity.reasoningEffort": {
          "type": "string",
          "default": "auto",
          "description": "Model-specific thinking effort. Auto uses the provider default. Choose supported values in the chat picker, or budget:<tokens> for a model with a thinking token budget.",
          "markdownDeprecationMessage": "Not used. Set reasoning effort in **Andromity Settings → Preferences → Reasoning Effort** or from the chat's model picker; it is saved in `config.toml`."
        },
        "andromity.soundNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Play sound notifications on turn finish or approval required."
        },
        "andromity.includeCoAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically append 'Co-authored-by: Andromity <333054755+andromity-bot@users.noreply.github.com>' to AI-generated commit messages and to commits the agent creates."
        },
        "andromity.includeAssistedBy": {
          "type": "boolean",
          "default": false,
          "description": "Add an 'Assisted-by: Andromity/<version> (<provider>/<model>)' trailer to commits the agent creates, naming the model that wrote the change."
        },
        "andromity.autoOpenSidebar": {
          "type": "string",
          "default": "always",
          "enum": [
            "firstTime",
            "always",
            "never"
          ],
          "description": "Automatically open the Andromity assistant sidebar (first time after install, every time VS Code starts, or never)."
        },
        "andromity.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Send anonymous usage and performance telemetry: launches, error categories, and which features are used (feature names only, never prompts, code or file paths). Also follows VS Code's telemetry setting."
        },
        "andromity.gatewayUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Override the AgenticMarket gateway URL (https on agenticmarket.dev, or loopback for local development). Empty uses the default."
        },
        "andromity.webAppUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Override the AgenticMarket sign-in site URL (https on agenticmarket.dev, or loopback for local development). Empty uses the default."
        },
        "andromity.serverPort": {
          "type": "number",
          "default": 0,
          "description": "TCP port to connect to an external Andromity daemon (0 for embedded stdio process)."
        },
        "andromity.mascotEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the animated mascot companion (Andro-Pet) in the chat sidebar."
        },
        "andromity.wallpaper.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable background wallpaper atmosphere with water ripples and floating asterisks. (⚠️ Note: May increase battery usage on portable devices)."
        },
        "andromity.wallpaper.rippleIntensity": {
          "type": "string",
          "default": "medium",
          "enum": [
            "off",
            "light",
            "medium",
            "strong"
          ],
          "description": "Intensity of the environmental water ripple effect on mouse hover."
        },
        "andromity.wallpaper.floatingAsterisks": {
          "type": "boolean",
          "default": true,
          "description": "Show subtle floating asterisks that react to mouse movement."
        },
        "andromity.wallpaper.cursorLightAura": {
          "type": "boolean",
          "default": true,
          "description": "Soft radial cursor spotlight aura on the background."
        },
        "andromity.waterfallAutoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the live Waterfall execution trace side-by-side when an agent session begins."
        },
        "andromity.ollamaHost": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "scope": "machine",
          "markdownDescription": "Base URL of your Ollama server, for example `http://192.168.1.20:11434`. When you set it, Andromity saves it as the Ollama address in `config.toml`, so the terminal app uses it too. Leave it unset to keep the address in `config.toml` (`http://localhost:11434` by default)."
        },
        "andromity.airGap.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Air-gap mode: Andromity makes no network connections except to this machine and the hosts in `#andromity.airGap.allowedHosts#`. Cloud models, web search, remote MCP servers, sign-in and telemetry are turned off, and commands the agent runs are blocked from the internet where possible. A project can turn this on; only your user settings can turn it off. For complete isolation, also use your firewall. Changing it restarts the Andromity engine."
        },
        "andromity.airGap.allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Private-network hosts Andromity may reach in air-gap mode, for example a shared model server: `10.0.0.5`, `10.0.0.0/8` or `gpu-box.lan`. Public addresses are ignored. User settings only, so a repository cannot widen this list."
        }
      }
    },
