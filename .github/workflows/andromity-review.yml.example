name: "Andromity Review"

on:
  pull_request:
    types: [opened, synchronize, reopened]
  issue_comment:
    types: [created]

permissions:
  contents: read
  pull-requests: write
  issues: write

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.event.issue.number || github.ref }}
  cancel-in-progress: true

jobs:
  review:
    name: "Andromity Code Review"
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request' || (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@andromity'))
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Andromity Action
        uses: agenticmarket/andromity@main
        with:
          api-key: ${{ secrets.OPENROUTER_API_KEY }}
          model: "openrouter/deepseek/deepseek-v4.1-flash"
          github-token: ${{ secrets.GITHUB_TOKEN }}
